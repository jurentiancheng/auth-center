# 复制为 .env 后按需修改。
# .env 不要提交到版本库（见 .gitignore）—— 它只该存在于部署环境与本地。

# 必填。认证服务不会为签名密钥提供默认值：给默认值比启动失败更危险。
# 生成：openssl rand -base64 48
JWT_SECRET=

# 数据库
DATABASE_URL=mysql://root:root@127.0.0.1:18306/auth_center
DB_MAX_CONNECTIONS=100
DB_MIN_CONNECTIONS=5
DB_CONNECT_TIMEOUT_SECS=20

# 监听地址与令牌有效期（秒）
LISTEN_ADDR=0.0.0.0:18080
JWT_EXPIRE_SECONDS=7200
