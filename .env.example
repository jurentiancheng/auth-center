# 复制为 .env 后按需修改。所有配置项都有默认值，未设置的项回落到默认值。
# 空白串（如 `SERVER_PORT=`）同样视为未设置。已存在的进程环境变量优先级高于 .env。

# ===== HTTP 服务 =====
# 监听地址，默认 0.0.0.0
SERVER_HOST=0.0.0.0
# 监听端口，默认 18080
SERVER_PORT=18080

# ===== 数据库 =====
# 默认 mysql://root:root@127.0.0.1:18306/auth_center
DATABASE_URL="mysql://root:root@127.0.0.1:18306/auth_center"
# 连接池最大连接数，默认 100
DATABASE_MAX_CONNECTIONS=100
# 连接池最小连接数，默认 5
DATABASE_MIN_CONNECTIONS=5
# 建连超时（秒），默认 20
DATABASE_CONNECT_TIMEOUT_SECS=20
# 是否打印 sqlx 的 SQL 日志，默认 false；接受 true/false、1/0、yes/no、on/off
DATABASE_SQLX_LOGGING=false

# ===== 日志 =====
# 取值同 RUST_LOG，如 debug、info、info,auth_center=trace，默认 debug
LOG_LEVEL=debug
